# Headers for files Cloudflare serves straight from the static assets, before
# the Worker (and so next.config.ts's headers()) ever runs.

# Content-hashed build output: safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Same as next.config.ts: the service worker must never be served stale, or
# fixes to it would never reach installed phones.
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self'
