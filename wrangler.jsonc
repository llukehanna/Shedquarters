{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "house-ladder",
  "routes": [
    { "pattern": "die.lukeghanna.com", "custom_domain": true }
  ],
  "account_id": "0086bd2cb9895f573c0ce63c3012104e",
  // The OpenNext worker, wrapped to add the nightly backup's Cron Trigger.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve /offline.html as itself. The default would 307 it to /offline,
    // and the service worker caches and serves it by that exact name.
    "html_handling": "none"
  },
  // die.lukeghanna.com is the only front door. The workers.dev URL is off:
  // it bypassed the zone (no WAF or rate limiting possible there), and on
  // 2026-10-26 an hour of outside traffic through it drove ~800 Error 1102s
  // (CPU limit). Nothing depends on it: the cron calls the Worker in-process
  // (custom-worker.ts) and scripts/smoke-prod.ts targets the custom domain.
  "workers_dev": false,
  "preview_urls": false,
  // Nightly backup, 09:00 UTC (1–2am in Los Angeles, after a night has
  // ended). custom-worker.ts's `scheduled` handler runs it.
  "triggers": { "crons": ["0 9 * * *"] },
  // Private store for the nightly JSON dumps (lib/backup-store.ts). KV, not
  // R2: R2 has to be enabled (with a payment method) in the dashboard first,
  // and a dump a day is far inside KV's free tier (1 GB, 1,000 writes a day).
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "25eb8c47d0814f84bb5d976b0db25832" }
  ],
  // Hyperdrive: pooled, pre-authenticated connections to Neon, so a request
  // no longer pays a TLS handshake and SCRAM auth inside the Worker
  // (lib/db.ts uses it when the binding exists, DATABASE_URL otherwise).
  // Not created yet. To turn it on, create it once (docs/OPERATIONS.md), then
  // uncomment this block with the id that prints:
  //
  //   npx wrangler hyperdrive create house-ladder-db --caching-disabled \
  //     --connection-string='<Neon DIRECT connection string, not -pooler>'
  //
  // QUERY CACHING MUST STAY OFF (--caching-disabled). It is on by default and
  // serves plain SELECTs up to a minute stale; this app reads its own writes
  // (the table after a game, the ladder after a void), so a cached read is a
  // wrong screen. Check with `npx wrangler hyperdrive get <id>`.
  // The PIN gate never uses it: its transaction takes an advisory lock, which
  // Hyperdrive doesn't support, so lib/gate.ts uses lib/db.ts's directSql.
  // After enabling, run the production check in docs/OPERATIONS.md.
  // localConnectionString is what `wrangler dev` / `opennextjs-cloudflare
  // preview` use in its place (the local Docker database from
  // docs/OPERATIONS.md, not a secret; change the port if yours differs).
  //
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<id from hyperdrive create>",
  //     "localConnectionString": "postgresql://houseladder:houseladder@localhost:55432/houseladder"
  //   }
  // ],
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): DATABASE_URL, HOUSE_PASSCODE, AUTH_SECRET,
  // CRON_SECRET. Never in this file.
}
